# Copy to your host's environment settings (not needed for local play)
PORT=3000
# Long random string — keeps players logged in across restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Postgres connection string (e.g. from Neon). Leave empty to store players in data/users.json
DATABASE_URL=
# Testing only: speed up matches (2 = double speed) / force a map (meadow, canyon, glacier)
# GAME_SPEED=1
# FORCE_MAP=
